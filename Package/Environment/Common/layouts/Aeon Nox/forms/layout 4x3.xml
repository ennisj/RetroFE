<layout width="1600" height="1200" font="fonts/OpenSans.ttf" loadFontSize="40" fontColor="dedede">

<!-- Aeon Nox: Settings, Manage, Sources and the other screens, drawn over the page behind.
     Image paths are relative to this page's folder. -->

    <!-- Background -->
    <image src="../images/background.png" x="0" y="0" width="1600" height="1200" layer="0"/>

    <!-- Top bar (no clock: a form page has no selected item, which reloadableText needs) -->
    <image src="../images/topbar.png" x="0" y="0" width="1600" height="50" layer="1"/>
    <text value="RETROFE" x="24" y="25" xOrigin="left" yOrigin="center" font="fonts/BebasNeue.ttf" fontSize="46" loadFontSize="46" fontColor="75c8f7" layer="2"/>

    <!-- Panel: the theme's info panel and its frame, stretched (seen at x 100-1500, y 70-1160) -->
    <image src="../images/system_info_bg.png" x="800" y="615" width="1443" height="1228" xOrigin="center" yOrigin="center" layer="2"/>
    <image src="../images/system_info_overlay.png" x="800" y="615" width="1443" height="1228" xOrigin="center" yOrigin="center" layer="4"/>

    <form x="800" y="615" width="1320" height="1050" xOrigin="center" yOrigin="center" labelWidth="420"
          font="fonts/OpenSans.ttf" loadFontSize="40" fontSize="34" fontColor="dedede" focusColor="ffffff"
          rowHeight="50" focusImage="../images/form_focus.png" noteAlpha="0.6" disabledAlpha="0.35"
          rowDetailColor="a9d8f5" rowDetailAlpha="0.8" headerColor="75c8f7" headerAlpha="0.95"
          separatorColor="75c8f7" separatorAlpha="0.18" imageBackgroundColor="ffffff" imageBackgroundAlpha="0.06"
          statusColor="9fe3a6" infoColor="b8c4d0" errorColor="ff9a8a" confirmBackgroundColor="d9442f" confirmBackgroundAlpha="0.3"
          backgroundColor="000000" backgroundAlpha="0" titleDetail="info:pendingChanges" layer="3"/>

</layout>
