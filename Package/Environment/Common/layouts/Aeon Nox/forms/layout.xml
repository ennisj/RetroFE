<layout width="1920" height="1080" font="fonts/RobotoCondensed-Regular.ttf" loadFontSize="44" fontColor="e6e6e6">

<!-- Aeon Nox: Settings, Manage, Sources and the other screens, drawn over the page behind.
     Two panels, as on Home: the screen's rows on the left, and on the right the focused
     row's picture, status and help (<formHelp>). Image paths are relative to this page's folder. -->

    <!-- Background -->
    <image src="../images/background.png" x="0" y="0" width="1920" height="1080" layer="0"/>

    <!-- Top bar (no clock: a form page has no selected item, which reloadableText needs) -->
    <image src="../images/topbar.png" x="0" y="0" width="1920" height="50" layer="1"/>
    <text value="RETROFE" x="24" y="25" xOrigin="left" yOrigin="center" font="fonts/BebasNeue.ttf" fontSize="46" loadFontSize="46" fontColor="75c8f7" layer="2"/>

    <!-- The rows' panel: the theme's info panel and its frame, stretched (seen at x 40-1250, y 70-1040) -->
    <image src="../images/system_info_bg.png" x="645" y="555" width="1247" height="1093" xOrigin="center" yOrigin="center" layer="2"/>
    <image src="../images/system_info_overlay.png" x="645" y="555" width="1247" height="1093" xOrigin="center" yOrigin="center" layer="4"/>

    <!-- The help panel (seen at x 1270-1880, y 70-1040) -->
    <image src="../images/system_info_bg.png" x="1575" y="555" width="629" height="1093" xOrigin="center" yOrigin="center" layer="2"/>
    <image src="../images/system_info_overlay.png" x="1575" y="555" width="629" height="1093" xOrigin="center" yOrigin="center" layer="4"/>

    <form x="60" y="84" width="1170" height="942" labelWidth="430"
          font="fonts/RobotoCondensed-Regular.ttf" loadFontSize="44" fontSize="38" fontColor="e6e6e6" focusColor="ffffff"
          rowHeight="56" focusImage="../images/form_focus.png" noteAlpha="0.8" disabledAlpha="0.4"
          rowDetailColor="a9d8f5" rowDetailAlpha="0.9" headerColor="75c8f7" headerAlpha="1"
          separatorColor="75c8f7" separatorAlpha="0.18" imageBackgroundColor="ffffff" imageBackgroundAlpha="0.06"
          statusColor="9fe3a6" infoColor="c4d0dc" errorColor="ff9a8a" warningColor="f2c46d" successColor="9fe3a6"
          confirmBackgroundColor="d9442f" confirmBackgroundAlpha="0.3" buttonColor="75c8f7" buttonAlpha="0.1"
          backgroundColor="000000" backgroundAlpha="0" layer="3"/>

    <formHelp x="1286" y="90" width="578" height="930"
              font="fonts/RobotoCondensed-Regular.ttf" loadFontSize="44" fontSize="32" fontColor="e6e6e6"
              headingColor="ffffff" detailColor="a9d8f5" warningColor="f2c46d" errorColor="ff9a8a" successColor="9fe3a6"
              noteAlpha="0.85" headingFont="fonts/Oswald-Bold.ttf" headingScale="1.5" pictureHeight="300"
              imageBackgroundColor="000000" imageBackgroundAlpha="0.35" layer="3"
              defaultImage="../collections/Home/medium_artwork/icon/Manage.png">
        <!-- Rows without a picture of their own show Home's icon for the part of RetroFE they're in -->
        <defaultImage forms="settings control*" src="../collections/Home/medium_artwork/icon/Settings.png"/>
        <defaultImage forms="sources package" src="../collections/Home/medium_artwork/icon/Catalog.png"/>
    </formHelp>

</layout>
