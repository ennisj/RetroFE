# RetroFE theme editor widget (from One Saucier; see docs/design/theme-editor.md)
# Changed: no Hardware Decode (no hwdec), no Transform Video (no transform=).
# The src is written relative to the page's folder ({{PAGEROOT}}), so it
# resolves first time on collection template pages too.
# Loop Video: numLoops="1" plays once; "0" follows the global loop setting.
[widget]
id = static_video
name = Static Video
category = static
color = 45C8D8
glyph = VID
summary = A fixed video clip shipped with the theme (looping backgrounds).
info = plain <video> - src = the chosen file
w = 480
h = 270
minw = 32
minh = 18
layer = 1

[var]
token = SRC
name = Video File
type = file
filter = video
default = videos/background.mp4

[var]
token = LOOP
name = Loop Video
type = bool
default = true

[var]
token = STRETCH
name = Fill Screen
type = bool
default = false

[fragment]
<video id="{{ID}}" src="{{PAGEROOT}}{{SRC}}" x="{{CX}}" y="{{CY}}" xOrigin="center" yOrigin="center" {{?STRETCH}}width="stretch" height="stretch" {{/STRETCH}}{{!STRETCH}}width="{{W}}" height="{{H}}" {{/STRETCH}}numLoops="{{LOOP:0:1}}" alpha="{{ALPHA}}" layer="{{LAYER}}">
  {{ANIM_DEFAULTS}}
</video>

[animDefaults]
<onEnter><set duration="0.35"><animate type="alpha" from="0" to="{{ALPHA}}" algorithm="easeoutquadratic"/></set></onEnter>
