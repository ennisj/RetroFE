# RetroFE theme editor widget (from One Saucier; see docs/design/theme-editor.md)
# Changed: menu modes are the ones PageBuilder::buildMenu reads; the default
# is no mode (collection items fall back to their system art by themselves).
[widget]
id = wheel_vertical
name = Vertical Logo Wheel
category = menu
color = C9A0E0
summary = The scrolling game/collection wheel, logo art per item.
info = menu type=custom - imageType=logo
w = 308
h = 976
minw = 100
minh = 200
layer = 14
menu = true

[var]
token = TEXTFALLBACK
name = Text Fallback
type = bool
default = true

[var]
token = IMAGETYPE
name = Art Type
type = text
default = logo
options = logo|screenshot|artwork_front|artwork_front_s|title|background|marquee|video|story|fanart

[var]
token = MODE
name = Art Source Mode
type = text
default =
options = -|layout|common|commonlayout

[var]
token = WHEELFONTSIZE
name = Text Size (px)
type = text
default =
numeric = true
step = 2
min = 0
max = 200

[var]
token = WHEELFONTCOLOR
name = Text Color
type = text
default =

[var]
token = WHEELSELCOLOR
name = Selected Text Color
type = text
default =

[fragment]
<menu id="{{ID}}" type="custom" imageType="{{IMAGETYPE}}" mode="{{MODE}}" orientation="vertical" scrollTime="{{SCROLLTIME}}" minScrollTime="0.06"{{?HASACCEL}} scrollAcceleration="{{SCROLLACCEL}}"{{/HASACCEL}} {{?TEXTFALLBACK}}textFallback="true" {{/TEXTFALLBACK}}layer="{{LAYER}}">
  {{MENU_ITEMS}}
</menu>
