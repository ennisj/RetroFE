# RetroFE theme editor widget (from One Saucier; see docs/design/theme-editor.md)
# Unchanged: everything it writes is read by this engine's PageBuilder.
[widget]
id = system_marquee
name = System Marquee
category = media
color = 4CC9B0
summary = The browsed system/menu collection's marquee art (when it ships one).
info = type=marquee - mode=system (system_artwork)
w = 746
h = 180
minw = 60
minh = 24
layer = 9

[var]
token = ASPECT
name = Maintain Aspect Ratio
type = bool
default = true

[fragment]
<reloadableImage id="{{ID}}" type="marquee" mode="system" x="{{CX}}" y="{{CY}}" xOrigin="center" yOrigin="center" width="{{W}}" {{ASPECT:maxHeight:height}}="{{H}}" alpha="{{ALPHA}}" layer="{{LAYER}}">
  {{ANIM_DEFAULTS}}
</reloadableImage>

[animDefaults]
<onEnter><set duration="0.25"><animate type="alpha" from="0" to="{{ALPHA}}" algorithm="easeoutquadratic"/></set></onEnter>
