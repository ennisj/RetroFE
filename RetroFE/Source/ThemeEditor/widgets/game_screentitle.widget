# RetroFE theme editor widget (from One Saucier; see docs/design/theme-editor.md)
# A preset over game_art: fragment, animations and attributes come from it.
# Changed: no layout_preferred mode (the game's own media), no Transform Video.
[widget]
id = game_screentitle
base = game_art
name = Game Screentitle
category = media
color = 6FCF6F
summary = Selected game's title-screen capture.
info = game_art preset - type=screentitle - the game's own art
w = 480
h = 360
minw = 40
minh = 30
layer = 9

[var]
token = IMAGETYPE
default = screentitle
