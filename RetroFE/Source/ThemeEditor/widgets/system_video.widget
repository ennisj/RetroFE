# RetroFE theme editor widget (from One Saucier; see docs/design/theme-editor.md)
# Changed: no Loop Video (reloadableVideo doesn't read numLoops: it loops per
# the global setting), no Transform Video (no transform=).
[widget]
id = system_video
name = System Video
category = media
color = 4CC9B0
summary = The browsed system/menu collection's video panel.
info = imageType=video - mode=system (system_artwork)
w = 624
h = 492
minw = 80
minh = 45
layer = 10

[var]
token = ASPECT
name = Maintain Aspect Ratio
type = bool
default = true

[fragment]
<reloadableVideo id="{{ID}}" imageType="video" mode="system" x="{{CX}}" y="{{CY}}" xOrigin="center" yOrigin="center" width="{{W}}" {{ASPECT:maxHeight:height}}="{{H}}" alpha="{{ALPHA}}" layer="{{LAYER}}">
  {{ANIM_DEFAULTS}}
</reloadableVideo>

[animDefaults]
<onEnter><set duration="0.25"><animate type="alpha" from="0" to="{{ALPHA}}" algorithm="easeoutquadratic"/></set></onEnter>
