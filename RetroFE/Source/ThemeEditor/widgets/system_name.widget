# RetroFE theme editor widget (from One Saucier; see docs/design/theme-editor.md)
# Unchanged: everything it writes is read by this engine's PageBuilder.
[widget]
id = system_name
name = System Name
category = text
color = 4CC9B0
glyph = SN
summary = The browsed system/menu collection's name.
info = type=collectionName
w = 450
h = 90
minw = 60
minh = 20
layer = 12

[var]
token = AUTOFIT
name = Auto Fit Text
type = bool
default = true

[var]
token = UPPER
name = Uppercase
type = bool
default = true

[var]
token = RIGHTALIGN
name = Anchor Right Edge
type = bool
default = false

[fragment]
<reloadableText id="{{ID}}" type="collectionName" {{?RIGHTALIGN}}x="{{X2}}" xOrigin="right" {{/RIGHTALIGN}}{{!RIGHTALIGN}}x="{{X}}" xOrigin="left" {{/RIGHTALIGN}}y="{{CY}}" yOrigin="center" {{?HASFONT}}font="{{FONT}}" {{/HASFONT}}{{?HASFONTCOLOR}}fontColor="{{FONTCOLOR}}" {{/HASFONTCOLOR}}fontSize="{{FS}}" maxHeight="{{H}}" {{?AUTOFIT}}maxWidth="{{W}}" {{/AUTOFIT}}{{?UPPER}}textFormat="uppercase" {{/UPPER}}alpha="{{ALPHA}}" layer="{{LAYER}}">
  {{ANIM_DEFAULTS}}
</reloadableText>

[animDefaults]
<onEnter><set duration="0.25"><animate type="alpha" from="0" to="{{ALPHA}}" algorithm="easeoutquadratic"/></set></onEnter>
