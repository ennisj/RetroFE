# RetroFE theme editor widget (from One Saucier; see docs/design/theme-editor.md)
# Unchanged: everything it writes is read by this engine's PageBuilder.
[widget]
id = game_index
name = Game Index
category = text
color = 6FCFC0
glyph = #
summary = Position of the selected game in the list (e.g. 1 / 6).
info = type=collectionIndex / collectionIndexSize
w = 406
h = 78
minw = 60
minh = 16
layer = 15

[var]
token = INDEXTYPE
name = Index Type
type = text
default = collectionIndexSize
options = collectionIndex|collectionIndexSize|collectionSize

[var]
token = AUTOFIT
name = Fit Text To Box
type = bool
default = true

[var]
token = SCROLLUPDATE
name = Update While Scrolling
type = bool
default = true

[var]
token = RIGHTALIGN
name = Anchor Right Edge
type = bool
default = false

[fragment]
<reloadableText id="{{ID}}" type="{{INDEXTYPE}}" {{?RIGHTALIGN}}x="{{X2}}" xOrigin="right" {{/RIGHTALIGN}}{{!RIGHTALIGN}}x="{{X}}" xOrigin="left" {{/RIGHTALIGN}}y="{{CY}}" yOrigin="center" {{?HASFONT}}font="{{FONT}}" {{/HASFONT}}{{?HASFONTCOLOR}}fontColor="{{FONTCOLOR}}" {{/HASFONTCOLOR}}fontSize="{{FS}}" maxHeight="{{H}}" {{?AUTOFIT}}maxWidth="{{W}}" {{/AUTOFIT}}menuScrollReload="{{SCROLLUPDATE:true:false}}" alpha="{{ALPHA}}" layer="{{LAYER}}">
  {{ANIM_DEFAULTS}}
</reloadableText>

[animDefaults]
<onEnter><set duration="0.25"><animate type="alpha" from="0" to="{{ALPHA}}" algorithm="easeoutquadratic"/></set></onEnter>
